#!/bin/sh
# commit-msg — enforce the commit-message prefix convention (CLAUDE.md §4.1, §7).
# Argument $1 is the path to the file holding the proposed commit message.
#
# Validates the [S-XXX/tests], [S-XXX/impl], or [F-XXX/...] prefix. The TDD two-commit
# ORDERING (tests before impl) is verified separately by check_tdd.py --story at gate
# time / pre-push, since it spans more than the single commit being made.

set -e

# Resolve a python that ACTUALLY RUNS — see the note in scripts/hooks/pre-commit. On
# Windows the Microsoft Store alias resolves on PATH but is not an interpreter.
# Kept duplicated rather than sourced from a shared file on purpose: install-hooks.sh
# copies each hook standalone into .git/hooks, so a `.` include would break on install.
PY=""
for _cand in python3 python py "$HOME/.local/bin/python3" "$HOME/.local/bin/python" \
             /usr/local/bin/python3 /usr/bin/python3; do
  case "$_cand" in
    /*) _p="$_cand"; [ -x "$_p" ] || continue ;;
    *)  _p="$(command -v "$_cand" 2>/dev/null)" || continue ;;
  esac
  [ -n "$_p" ] || continue
  if "$_p" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
    PY="$_p"
    break
  fi
done
if [ -z "$PY" ]; then
  # FAIL CLOSED. This previously exited 0 ("skipping prefix check"), which silently
  # disabled a real gate whenever the interpreter was missing — and the pre-commit hook
  # right next to it already fails closed for the same condition. A gate that turns
  # itself off when the environment degrades is not a gate (CLAUDE.md §6).
  echo "commit-msg: no working python found on PATH — cannot verify the message prefix." >&2
  echo "  Tried: python3, python, py (a Microsoft Store alias does not count)." >&2
  echo "  (install python3, or commit with --no-verify and record the skip)." >&2
  exit 1
fi
ROOT="$(git rev-parse --show-toplevel)"
MSG="$(cat "$1")"
"$PY" "$ROOT/scripts/gates/check_tdd.py" --staged-msg "$MSG"
