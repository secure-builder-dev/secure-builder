#!/bin/sh
# pre-commit — local-attested gate backstop (CLAUDE.md §0, §6; GATE_ENFORCEMENT=local-attested).
#
# Runs the machine-checkable checks that apply to the STAGED change. This is
# defense-in-depth, NOT an unbypassable wall: a determined operator can `--no-verify`.
# That is by design for local-attested mode — the append-only gate log + git history
# make a skip visible and attributable, and the downstream platform team re-checks
# everything (PRD §2 Guarantee #2, §13).
#
# Install with scripts/install-hooks.sh (or use .pre-commit-config.yaml).

set -e

# Resolve a python that ACTUALLY RUNS, not merely one that resolves on PATH.
# On Windows, `command -v python3` happily returns the Microsoft Store "app execution
# alias" (…/WindowsApps/python3), which is not an interpreter: it prints a store advert
# and exits nonzero. Trusting it made every commit fail with a bogus error. Probe each
# candidate before accepting it.
# Absolute paths are probed too, not just PATH names: a hook inherits the environment of
# whatever launched git (IDE, agent shell, cron), and that PATH is often narrower than a
# login shell's. ~/.local/bin is where uv and pipx install on both Windows and Linux.
PY=""
for _cand in python3 python py "$HOME/.local/bin/python3" "$HOME/.local/bin/python" \
             /usr/local/bin/python3 /usr/bin/python3; do
  case "$_cand" in
    /*) _p="$_cand"; [ -x "$_p" ] || continue ;;
    *)  _p="$(command -v "$_cand" 2>/dev/null)" || continue ;;
  esac
  [ -n "$_p" ] || continue
  if "$_p" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
    PY="$_p"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no working python found — cannot run gate checks." >&2
  echo "  Probed PATH (python3, python, py) and ~/.local/bin, /usr/local/bin, /usr/bin." >&2
  echo "  A Microsoft Store alias resolves on PATH but is not an interpreter; it fails" >&2
  echo "  the probe on purpose." >&2
  echo "  (install python3, or commit with --no-verify and run checks manually)." >&2
  exit 1
fi
ROOT="$(git rev-parse --show-toplevel)"

echo "pre-commit: running local-attested gate checks…"

# (1) Secret / forbidden-file scan — Guarantee #7, PRD §11.
"$PY" "$ROOT/scripts/gates/secret_scan.py" --staged || exit 1

# (2) App quality stage — only if the project defines one (web track: npm scripts).
#     Skipped silently in the docs-only engine repo, which has no package.json.
if [ -f "$ROOT/package.json" ]; then
  if command -v npm >/dev/null 2>&1; then
    echo "pre-commit: npm project detected — running lint / typecheck / test…"
    npm run --silent lint --if-present || { echo "pre-commit: lint failed"; exit 1; }
    npm run --silent typecheck --if-present || { echo "pre-commit: typecheck failed"; exit 1; }
    npm test --silent --if-present || { echo "pre-commit: tests failed"; exit 1; }
  fi
fi

echo "pre-commit: checks passed."
